# ASP.NET Core reads these through the standard double-underscore convention.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=attendance;Username=postgres;Password=postgres
# Railway style URL also works:  DATABASE_URL=postgres://user:pass@host:5432/db
Redis__ConnectionString=localhost:6379
# Upstash:  rediss://default:<password>@<host>:6379   (or  host:6379,password=...,ssl=true)
Jwt__Key=change-me-to-a-random-string-of-at-least-32-characters
Jwt__Issuer=attendance-api
Jwt__Audience=attendance-clients
AllowedOrigins=http://localhost:5173
Firebase__CredentialsBase64=
# base64 of the Firebase service-account JSON:  base64 -w0 service-account.json
Seed__Enabled=true
Swagger__Enabled=true
Alerts__IntervalMinutes=15
Alerts__MinSessions=3
Security__HttpsRedirection=false
